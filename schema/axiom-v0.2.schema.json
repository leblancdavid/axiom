{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/schema/axiom-v0.2.schema.json",
  "title": "Lykoi v0.2 serialization envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["axiom_version", "application", "types", "capabilities", "state", "invariants", "behaviors", "commands", "migrations", "errors"],
  "properties": {
    "axiom_version": {"const": "0.2"},
    "application": {"$ref": "#/$defs/named"},
    "types": {"type": "array", "items": {"$ref": "#/$defs/type"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "state": {"type": "array", "items": {"$ref": "#/$defs/state"}},
    "invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
    "behaviors": {"type": "array", "items": {"$ref": "#/$defs/behavior"}},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "migrations": {"type": "array", "items": {"$ref": "#/$defs/migration"}},
    "errors": {"type": "array", "items": {"type": "object", "required": ["id", "code"], "properties": {"id": {"$ref": "#/$defs/id"}, "code": {"type": "string"}}, "additionalProperties": false}},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "named": {"type": "object", "required": ["id", "name"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}}, "additionalProperties": false},
    "typed": {"type": "object", "required": ["id", "name", "type"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "type": {"$ref": "#/$defs/id"}, "nullable": {"const": true}}, "additionalProperties": false},
    "type": {
      "oneOf": [
        {"type": "object", "required": ["id", "name", "kind", "values"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "kind": {"const": "enum"}, "values": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}}, "additionalProperties": false},
        {"type": "object", "required": ["id", "name", "kind", "fields"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "kind": {"const": "record"}, "fields": {"type": "array", "items": {"$ref": "#/$defs/typed"}, "minItems": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["id", "name", "kind", "item_type"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "kind": {"const": "list"}, "item_type": {"$ref": "#/$defs/id"}}, "additionalProperties": false}
      ]
    },
    "capability": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["json_file", "utc_clock", "uuid_v4"]}, "path": {"type": "string"}, "missing_file": {"const": "empty_collection"}}, "additionalProperties": false},
    "state": {"type": "object", "required": ["id", "name", "type", "storage", "key_field", "schema_version", "invariants"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "type": {"$ref": "#/$defs/id"}, "storage": {"$ref": "#/$defs/id"}, "key_field": {"$ref": "#/$defs/id"}, "schema_version": {"type": "integer", "minimum": 1}, "invariants": {"$ref": "#/$defs/ids"}}, "additionalProperties": false},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "invariant": {"type": "object", "required": ["id", "kind", "state"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["unique_field", "all_records_valid"]}, "state": {"$ref": "#/$defs/id"}, "field": {"$ref": "#/$defs/id"}, "field_rules": {"type": "array", "items": {"type": "object", "required": ["kind", "field"], "properties": {"kind": {"enum": ["nonblank", "timestamp_utc"]}, "field": {"$ref": "#/$defs/id"}}, "additionalProperties": false}}}, "additionalProperties": false},
    "contract": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["nonblank_input", "timestamp_input", "record_exists", "record_field_equals", "result_field_equals", "result_field_equals_assignment", "result_in_state", "result_id_absent_from_state", "result_equals_state_sorted"]}, "input": {"$ref": "#/$defs/id"}, "field": {"$ref": "#/$defs/id"}, "state": {"$ref": "#/$defs/id"}, "value": {"type": ["string", "null"]}, "failure": {"type": "string"}}, "additionalProperties": false},
    "assignment": {"type": "object", "required": ["field", "source"], "properties": {"field": {"$ref": "#/$defs/id"}, "source": {"enum": ["literal", "input", "input_default", "capability"]}, "id": {"$ref": "#/$defs/id"}, "value": {"type": ["string", "null"]}}, "additionalProperties": false},
    "behavior": {"type": "object", "required": ["id", "name", "kind", "state", "inputs", "output", "dependencies", "reads", "writes", "effects", "conditions", "assignments", "guarantees", "failures"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "kind": {"enum": ["create", "list", "update", "delete"]}, "state": {"$ref": "#/$defs/id"}, "inputs": {"type": "array", "items": {"$ref": "#/$defs/typed"}}, "output": {"$ref": "#/$defs/id"}, "dependencies": {"$ref": "#/$defs/ids"}, "reads": {"$ref": "#/$defs/ids"}, "writes": {"$ref": "#/$defs/ids"}, "effects": {"type": "array", "items": {"enum": ["state_read", "state_write", "file_read", "file_write", "clock_read", "random_id"]}, "uniqueItems": true}, "conditions": {"type": "array", "items": {"$ref": "#/$defs/contract"}}, "assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}}, "guarantees": {"type": "array", "items": {"$ref": "#/$defs/contract"}}, "failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "lookup": {"type": "object", "required": ["field", "input"], "properties": {"field": {"$ref": "#/$defs/id"}, "input": {"$ref": "#/$defs/id"}}, "additionalProperties": false}, "order_by": {"$ref": "#/$defs/ids"}, "filter": {"$ref": "#/$defs/filter"}}, "additionalProperties": false},
    "predicate": {"oneOf": [{"type": "object", "required": ["kind", "field", "value"], "properties": {"kind": {"const": "field_equals"}, "field": {"$ref": "#/$defs/id"}, "value": {"type": ["string", "null"]}}, "additionalProperties": false}, {"type": "object", "required": ["kind", "field", "clock"], "properties": {"kind": {"const": "field_before_clock"}, "field": {"$ref": "#/$defs/id"}, "clock": {"$ref": "#/$defs/id"}}, "additionalProperties": false}]},
    "filter": {"oneOf": [{"$ref": "#/$defs/predicate"}, {"type": "object", "required": ["kind", "predicates"], "properties": {"kind": {"const": "all"}, "predicates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/predicate"}}}, "additionalProperties": false}]},
    "command": {"type": "object", "required": ["id", "token", "arguments"], "oneOf": [{"required": ["behavior"]}, {"required": ["migration"]}], "properties": {"id": {"$ref": "#/$defs/id"}, "token": {"type": "string"}, "behavior": {"$ref": "#/$defs/id"}, "migration": {"$ref": "#/$defs/id"}, "arguments": {"type": "array", "items": {"type": "object", "required": ["flag", "input", "required"], "properties": {"flag": {"type": "string"}, "input": {"$ref": "#/$defs/id"}, "required": {"type": "boolean"}}, "additionalProperties": false}}}, "additionalProperties": false},
    "migration": {"type": "object", "required": ["id", "state", "from_version", "to_version", "add_fields", "effects"], "properties": {"id": {"$ref": "#/$defs/id"}, "state": {"$ref": "#/$defs/id"}, "from_version": {"type": "integer", "minimum": 1}, "to_version": {"type": "integer", "minimum": 2}, "effects": {"type": "array", "items": {"enum": ["state_read", "state_write", "file_read", "file_write"]}, "uniqueItems": true}, "add_fields": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["field", "value"], "properties": {"field": {"$ref": "#/$defs/id"}, "value": {"type": ["string", "null"]}}, "additionalProperties": false}}}, "additionalProperties": false},
    "scenario": {"type": "object", "required": ["id", "behavior", "clock", "records", "expected_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "behavior": {"$ref": "#/$defs/id"}, "clock": {"type": "string"}, "records": {"type": "array", "items": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}}, "expected_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}
  }
}
